Dialogue: 0,0:00:29.40,0:00:33.39,对白 日语,,0,0,0,,15歳の誕生日の贈り物にルーデウスをもらった
Dialogue: 0,0:00:35.01,0:00:36.98,对白 日语,,0,0,0,,約束とはちょっと違うけれど
Dialogue: 0,0:00:37.53,0:00:39.12,对白 日语,,0,0,0,,ルーデウスと結ばれた
Dialogue: 0,0:00:41.81,0:00:42.74,对白 日语,,0,0,0,,小さい
Dialogue: 0,0:00:46.69,0:00:49.98,对白 日语,,0,0,0,,でも私はいつも助けてもらってばかり
Dialogue: 0,0:00:52.00,0:00:54.98,对白 日语,,0,0,0,,私はルーデウスにふさわしくない
Dialogue: 0,0:04:29.95,0:04:32.75,对白 日语,,0,0,0,,簡単だぜ できんのか?
Dialogue: 0,0:04:33.21,0:04:34.21,对白 日语,,0,0,0,,やるわ!
Dialogue: 0,0:04:40.09,0:04:41.09,对白 日语,,0,0,0,,はっ
Dialogue: 0,0:04:41.87,0:04:43.21,对白 日语,,0,0,0,,よし 剣を見る
Dialogue: 0,0:04:43.39,0:04:45.47,对白 日语,,0,0,0,,なんて このようなもの… ジノ 相手をしてやれ
Dialogue: 0,0:04:45.63,0:04:47.21,对白 日语,,0,0,0,,えっ? あっ はい!
Dialogue: 0,0:04:47.63,0:04:49.67,对白 日语,,0,0,0,,そいつは うちの最年少だ
Dialogue: 0,0:04:49.85,0:04:52.56,对白 日语,,0,0,0,,まだまだ マッチョレイが結構 やるぜ
Dialogue: 0,0:04:54.47,0:04:55.47,对白 日语,,0,0,0,,えいっ
Dialogue: 0,0:04:55.48,0:04:56.48,对白 日语,,0,0,0,,あっ
Dialogue: 0,0:04:58.90,0:04:59.93,对白 日语,,0,0,0,,では 中央で…
Dialogue: 0,0:05:00.10,0:05:01.10,对白 日语,,0,0,0,,あっ
Dialogue: 0,0:05:01.24,0:05:02.24,对白 日语,,0,0,0,,えっ?
Dialogue: 0,0:05:04.78,0:05:05.78,对白 日语,,0,0,0,,あっ
Dialogue: 0,0:05:06.70,0:05:07.70,对白 日语,,0,0,0,,あっ
Dialogue: 0,0:05:17.30,0:05:19.08,对白 日语,,0,0,0,,な? マッチョレイだろ?
Dialogue: 0,0:05:20.00,0:05:21.50,对白 日语,,0,0,0,,本当にそうね
Dialogue: 0,0:05:21.75,0:05:22.50,对白 日语,,0,0,0,,あっ…
Dialogue: 0,0:05:22.68,0:05:24.72,对白 日语,,0,0,0,,よし 次はニナ お前だ
Dialogue: 0,0:05:25.48,0:05:26.48,对白 日语,,0,0,0,,はい!
Dialogue: 0,0:05:26.90,0:05:28.90,对白 日语,,0,0,0,,今度は 向かい合ってからだ
Dialogue: 0,0:05:29.31,0:05:33.31,对白 日语,,0,0,0,,不意打ちもいいが 用意どんでの剣も見せてくれよ
Dialogue: 0,0:05:34.24,0:05:35.24,对白 日语,,0,0,0,,あっ
Dialogue: 0,0:05:49.00,0:05:50.00,对白 日语,,0,0,0,,殺す…
Dialogue: 0,0:05:50.25,0:05:51.25,对白 日语,,0,0,0,,うっ…
Dialogue: 0,0:05:51.68,0:05:52.68,对白 日语,,0,0,0,,はじめ!
Dialogue: 0,0:05:54.10,0:05:55.10,对白 日语,,0,0,0,,うっ つい!
Dialogue: 0,0:05:55.48,0:05:56.36,对白 日语,,0,0,0,,あっ
Dialogue: 0,0:05:58.31,0:05:59.31,对白 日语,,0,0,0,,お、クソッ
Dialogue: 0,0:06:15.87,0:06:16.66,对白 日语,,0,0,0,,あっ
Dialogue: 0,0:06:16.84,0:06:19.06,对白 日语,,0,0,0,,あ やめ やめろ!
Dialogue: 0,0:06:25.08,0:06:25.46,对白 日语,,0,0,0,,あ…
Dialogue: 0,0:06:38.50,0:06:40.96,对白 日语,,0,0,0,,ここには甘っちゃない奴しかいないな
Dialogue: 0,0:06:40.96,0:06:42.06,对白 日语,,0,0,0,,貴様
Dialogue: 0,0:06:42.06,0:06:43.84,对白 日语,,0,0,0,,我らを侮辱する気か
Dialogue: 0,0:06:43.84,0:06:45.87,对白 日语,,0,0,0,,皆のどこが賢術だ
Dialogue: 0,0:06:45.87,0:06:48.50,对白 日语,,0,0,0,,わりわりちょっと見誤ってたな
Dialogue: 0,0:06:48.50,0:06:52.92,对白 日语,,0,0,0,,俺が相手してやるよ
Dialogue: 0,0:06:52.92,0:06:55.30,对白 日语,,0,0,0,,師匠が出るまでもありません
Dialogue: 0,0:06:55.30,0:06:56.30,对白 日语,,0,0,0,,私めが
Dialogue: 0,0:06:56.30,0:07:03.68,对白 日语,,0,0,0,,慌てんなよ
Dialogue: 0,0:07:03.68,0:07:05.92,对白 日语,,0,0,0,,ちゃんと手加減をしてやるから
Dialogue: 0,0:07:05.92,0:07:08.28,对白 日语,,0,0,0,,ってお前いい剣持ってんな
Dialogue: 0,0:07:08.28,0:07:10.81,对白 日语,,0,0,0,,名校ユリアンのだろそれ
Dialogue: 0,0:07:10.81,0:07:12.18,对白 日语,,0,0,0,,知らないわ
Dialogue: 0,0:07:12.18,0:07:14.66,对白 日语,,0,0,0,,ミグルド族にもらったものよ
Dialogue: 0,0:07:14.66,0:07:15.31,对白 日语,,0,0,0,,あ、そう
Dialogue: 0,0:07:15.31,0:07:24.84,对白 日语,,0,0,0,,こいつもユリアンのだぜ
Dialogue: 0,0:07:24.84,0:07:25.28,对白 日语,,0,0,0,,あ、そう
Dialogue: 0,0:07:25.30,0:07:38.40,对白 日语,,0,0,0,,行くぜ
Dialogue: 0,0:07:55.30,0:07:59.92,对白 日语,,0,0,0,,お見事
Dialogue: 0,0:07:59.92,0:08:00.52,对白 日语,,0,0,0,,お見事です
Dialogue: 0,0:08:00.52,0:08:00.86,对白 日语,,0,0,0,,エリス
Dialogue: 0,0:08:00.86,0:08:05.02,对白 日语,,0,0,0,,エリス
Dialogue: 0,0:08:05.02,0:08:18.43,对白 日语,,0,0,0,,ギレーヌ
Dialogue: 0,0:08:18.43,0:08:20.63,对白 日语,,0,0,0,,エリスを治療しろ
Dialogue: 0,0:08:20.63,0:08:24.37,对白 日语,,0,0,0,,今日からあいつは賢聖だ
Dialogue: 0,0:08:24.37,0:08:24.60,对白 日语,,0,0,0,,あいつは賢聖だ
Dialogue: 0,0:08:24.60,0:08:27.48,对白 日语,,0,0,0,,明日から俺様が剣を教える
Dialogue: 0,0:08:27.48,0:08:30.58,对白 日语,,0,0,0,,師匠
Dialogue: 0,0:08:30.58,0:08:34.96,对白 日语,,0,0,0,,賢聖は光の太刀を習得した者のみに与えられる
Dialogue: 0,0:08:34.96,0:08:36.15,对白 日语,,0,0,0,,特別な称号
Dialogue: 0,0:08:36.15,0:08:38.62,对白 日语,,0,0,0,,あんな山猿も同然なガキに
Dialogue: 0,0:08:38.62,0:08:43.36,对白 日语,,0,0,0,,光の太刀を習得したガキを二人ものしてんだ
Dialogue: 0,0:08:43.36,0:08:45.22,对白 日语,,0,0,0,,十分だろうが
Dialogue: 0,0:08:45.22,0:08:46.32,对白 日语,,0,0,0,,しかし
Dialogue: 0,0:08:46.32,0:08:47.36,对白 日语,,0,0,0,,賢神ってな
Dialogue: 0,0:08:47.36,0:08:50.86,对白 日语,,0,0,0,,何かを覚えりゃなれるってわけじゃねえんだぜ
Dialogue: 0,0:08:50.86,0:08:54.58,对白 日语,,0,0,0,,特別な俺様ですら特別扱いされてねえんだよ
Dialogue: 0,0:08:54.60,0:08:58.54,对白 日语,,0,0,0,,何で賢聖程度を特別扱いする必要がある
Dialogue: 0,0:08:58.54,0:09:03.01,对白 日语,,0,0,0,,申し訳ありませんでした
Dialogue: 0,0:09:54.60,0:09:56.25,对白 日语,,0,0,0,,無心で剣を振れ
Dialogue: 0,0:09:56.63,0:10:01.01,对白 日语,,0,0,0,,無心で剣を振って 疲れたら座って休んで考えろ
Dialogue: 0,0:10:01.20,0:10:05.20,对白 日语,,0,0,0,,考えるのに疲れたら また立ち上がって剣を振れ
Dialogue: 0,0:10:08.08,0:10:09.12,对白 日语,,0,0,0,,うっ…
Dialogue: 0,0:10:11.24,0:10:14.70,对白 日语,,0,0,0,,えっ? ギレーヌさんが字を書けるって本当?
Dialogue: 0,0:10:14.96,0:10:17.84,对白 日语,,0,0,0,,そうらしいけど 読めるやつが誰もいないから
Dialogue: 0,0:10:18.00,0:10:19.58,对白 日语,,0,0,0,,確かめようがないんだって
Dialogue: 0,0:10:19.75,0:10:21.96,对白 日语,,0,0,0,,俺は嘘だと思うけどな
Dialogue: 0,0:10:22.12,0:10:24.30,对白 日语,,0,0,0,,父さんは何であんなやつを…
Dialogue: 0,0:10:24.60,0:10:30.10,对白 日语,,0,0,0,,あなた 剣の修行より 殴るほうが才能あるわよ
Dialogue: 0,0:10:30.27,0:10:32.20,对白 日语,,0,0,0,,ハハハハ 確かに
Dialogue: 0,0:10:34.77,0:10:36.70,对白 日语,,0,0,0,,ジノも何か言ってやりなさいよ
Dialogue: 0,0:10:36.86,0:10:37.70,对白 日语,,0,0,0,,えっ?
Dialogue: 0,0:10:39.74,0:10:43.82,对白 日语,,0,0,0,,たまには エリスさんも 僕らの合同稽古に参加してみない?
Dialogue: 0,0:10:44.00,0:10:46.12,对白 日语,,0,0,0,,はあ? 何言ってるのよ!
Dialogue: 0,0:10:46.27,0:10:49.20,对白 日语,,0,0,0,,あんな奴が父さんの 剣心の直弟子なのよ!
Dialogue: 0,0:10:49.37,0:10:50.87,对白 日语,,0,0,0,,ジノは悔しくないの!
Dialogue: 0,0:10:51.54,0:10:53.50,对白 日语,,0,0,0,,でも 僕は負けちゃったし
Dialogue: 0,0:10:53.68,0:10:54.58,对白 日语,,0,0,0,,剣心流にふさがって
Dialogue: 0,0:10:54.74,0:10:57.06,对白 日语,,0,0,0,,ふさわしくない戦い方で やられただけじゃない!
Dialogue: 0,0:10:57.22,0:10:59.77,对白 日语,,0,0,0,,きちんとした試合なら 遅れは取らないわ!
Dialogue: 0,0:11:18.24,0:11:20.87,对白 日语,,0,0,0,,剣を振るって難しいわね
Dialogue: 0,0:11:29.01,0:11:31.01,对白 日语,,0,0,0,,ギレーヌはもっと早い!
Dialogue: 0,0:11:31.18,0:11:33.56,对白 日语,,0,0,0,,ルイジェルドはもっと早い!
Dialogue: 0,0:11:33.74,0:11:35.98,对白 日语,,0,0,0,,剣心はもっと早い!
Dialogue: 0,0:11:36.15,0:11:39.86,对白 日语,,0,0,0,,そして ホルステッドは もっともっと早い!
Dialogue: 0,0:11:40.89,0:11:42.36,对白 日语,,0,0,0,,もっと早く!
Dialogue: 0,0:11:57.36,0:11:58.44,对白 日语,,0,0,0,,よし なすると君は結局 俺んやな
Dialogue: 0,0:11:58.44,0:12:01.10,对白 日语,,0,0,0,,ケンシンはどう動いていたのかしら?
Dialogue: 0,0:12:08.24,0:12:12.04,对白 日语,,0,0,0,,- 指先… 肩…
Dialogue: 0,0:12:16.70,0:12:17.92,对白 日语,,0,0,0,,ダメね
Dialogue: 0,0:12:39.94,0:12:43.87,对白 日语,,0,0,0,,ルーデウス
Dialogue: 0,0:13:23.72,0:13:42.60,对白 日语,,0,0,0,,まだまだね
Dialogue: 0,0:13:53.72,0:14:23.70,对白 日语,,0,0,0,,頼もう!
Dialogue: 0,0:14:23.72,0:14:25.62,对白 日语,,0,0,0,,どけと言っているのよ
Dialogue: 0,0:15:26.48,0:15:32.01,对白 日语,,0,0,0,,そこまでだ
Dialogue: 0,0:15:32.01,0:15:36.46,对白 日语,,0,0,0,,おお お久しぶりです 剣神様
Dialogue: 0,0:15:36.46,0:15:45.56,对白 日语,,0,0,0,,よく来たな 北帝
Dialogue: 0,0:15:45.56,0:15:49.25,对白 日语,,0,0,0,,剣神様からのお手紙を拝見いたしまして
Dialogue: 0,0:15:49.25,0:15:52.44,对白 日语,,0,0,0,,道場にうかがったところ あの子が
Dialogue: 0,0:15:52.92,0:15:55.75,对白 日语,,0,0,0,,これほどまで可烈な剣士は初めて見申した
Dialogue: 0,0:15:55.75,0:15:58.01,对白 日语,,0,0,0,,まるで獣のような
Dialogue: 0,0:15:58.01,0:16:01.87,对白 日语,,0,0,0,,ああ これが例の狂犬と呼ばれている子ですか
Dialogue: 0,0:16:01.87,0:16:03.43,对白 日语,,0,0,0,,ああ そうだ
Dialogue: 0,0:16:25.75,0:16:26.93,对白 日语,,0,0,0,,おかえり エリス
Dialogue: 0,0:16:26.93,0:16:52.93,对白 日语,,0,0,0,,師匠 なぜエリスに何も教えない
Dialogue: 0,0:16:52.93,0:16:54.41,对白 日语,,0,0,0,,教えたじゃねえか
Dialogue: 0,0:16:54.41,0:16:55.74,对白 日语,,0,0,0,,素振りのしかない
Dialogue: 0,0:16:55.75,0:16:56.25,对白 日语,,0,0,0,,仕方をか
Dialogue: 0,0:16:56.25,0:16:59.55,对白 日语,,0,0,0,,違う 鍛錬の仕方をだ
Dialogue: 0,0:16:59.55,0:17:02.13,对白 日语,,0,0,0,,師匠はいつも言っていたはずだ
Dialogue: 0,0:17:02.13,0:17:03.84,对白 日语,,0,0,0,,全てを合理的にやれと
Dialogue: 0,0:17:03.84,0:17:04.92,对白 日语,,0,0,0,,言ったな
Dialogue: 0,0:17:04.92,0:17:07.07,对白 日语,,0,0,0,,エリスのあれは何だ
Dialogue: 0,0:17:07.07,0:17:09.87,对白 日语,,0,0,0,,毎日バカの一つ覚えみたいに素振りをして
Dialogue: 0,0:17:09.87,0:17:11.75,对白 日语,,0,0,0,,どこが合理的なんだ
Dialogue: 0,0:17:11.75,0:17:12.40,对白 日语,,0,0,0,,ああ
Dialogue: 0,0:17:12.40,0:17:15.72,对白 日语,,0,0,0,,数年経ってもまだ光の太刀も使えない
Dialogue: 0,0:17:15.72,0:17:18.25,对白 日语,,0,0,0,,何で師匠が教えてやらない
Dialogue: 0,0:17:18.25,0:17:22.79,对白 日语,,0,0,0,,お前 いつからそんなめんどくせえことを言うようになったんだ
Dialogue: 0,0:17:22.79,0:17:25.14,对白 日语,,0,0,0,,ここに戻ってくる前からだ
Dialogue: 0,0:17:25.75,0:17:31.51,对白 日语,,0,0,0,,もう師匠の言うことは聞けねえってのか
Dialogue: 0,0:17:31.51,0:17:32.75,对白 日语,,0,0,0,,しかし
Dialogue: 0,0:17:32.75,0:17:36.24,对白 日语,,0,0,0,,ギレーヌ 俺様はな
Dialogue: 0,0:17:36.24,0:17:39.87,对白 日语,,0,0,0,,お前の教育について少しだけ後悔してんだ
Dialogue: 0,0:17:39.87,0:17:43.16,对白 日语,,0,0,0,,あの飢えた虎みてえだったギレーヌが
Dialogue: 0,0:17:43.16,0:17:46.09,对白 日语,,0,0,0,,牙の抜けた子猫ちゃんになっちまった
Dialogue: 0,0:17:46.09,0:17:48.25,对白 日语,,0,0,0,,あのままでいけば
Dialogue: 0,0:17:48.25,0:17:51.40,对白 日语,,0,0,0,,お前も今頃は剣帝だったのによ
Dialogue: 0,0:17:55.75,0:18:00.18,对白 日语,,0,0,0,,俺様はもう牙は抜かねえ
Dialogue: 0,0:18:00.18,0:18:02.53,对白 日语,,0,0,0,,意味がわからん
Dialogue: 0,0:18:02.53,0:18:04.68,对白 日语,,0,0,0,,なぜ稽古をつけてやらんのだ
Dialogue: 0,0:18:04.68,0:18:07.16,对白 日语,,0,0,0,,あれではエリスがかわいそうではないか
Dialogue: 0,0:18:07.16,0:18:10.24,对白 日语,,0,0,0,,いいか ギレーヌ
Dialogue: 0,0:18:10.24,0:18:12.40,对白 日语,,0,0,0,,俺様を超えたきゃ
Dialogue: 0,0:18:12.40,0:18:15.18,对白 日语,,0,0,0,,合理を突き詰めていけばいずれ超えられる
Dialogue: 0,0:18:15.18,0:18:17.57,对白 日语,,0,0,0,,だがあいつが目指してるのは
Dialogue: 0,0:18:17.57,0:18:19.72,对白 日语,,0,0,0,,竜神オルステッドだ
Dialogue: 0,0:18:19.72,0:18:23.59,对白 日语,,0,0,0,,奴は合理の外にいる存在だ
Dialogue: 0,0:18:23.59,0:18:25.74,对白 日语,,0,0,0,,俺様の教えだけじゃなくて
Dialogue: 0,0:18:25.75,0:18:55.74,对白 日语,,0,0,0,,俺様の教えだけじゃなくて
Dialogue: 0,0:18:55.75,0:18:56.37,对白 日语,,0,0,0,,こいつだ
Dialogue: 0,0:18:56.37,0:19:00.11,对白 日语,,0,0,0,,それがしの名は北帝オーベールコルベット
Dialogue: 0,0:19:00.11,0:19:03.07,对白 日语,,0,0,0,,島田では九尺犬と呼ばれている
Dialogue: 0,0:19:03.07,0:19:06.16,对白 日语,,0,0,0,,北神竜が何の用だ
Dialogue: 0,0:19:06.16,0:19:08.42,对白 日语,,0,0,0,,剣神様より頼まれ申した
Dialogue: 0,0:19:08.42,0:19:11.72,对白 日语,,0,0,0,,弟子の一人に稽古をつけてほしいと
Dialogue: 0,0:19:11.72,0:19:13.74,对白 日语,,0,0,0,,なぜ北神竜を
Dialogue: 0,0:19:13.74,0:19:15.98,对白 日语,,0,0,0,,エリスにはこいつらのような
Dialogue: 0,0:19:15.98,0:19:18.03,对白 日语,,0,0,0,,古俗な手は似合わんはずだ
Dialogue: 0,0:19:18.03,0:19:19.75,对白 日语,,0,0,0,,竜神が使ってくるからだ
Dialogue: 0,0:19:20.29,0:19:24.37,对白 日语,,0,0,0,,竜神とは一体何者なのだ
Dialogue: 0,0:19:24.37,0:19:25.29,对白 日语,,0,0,0,,知るかよ
Dialogue: 0,0:19:25.75,0:19:26.66,对白 日语,,0,0,0,,ただな
Dialogue: 0,0:19:26.66,0:19:30.27,对白 日语,,0,0,0,,あいつはいわゆる剣神竜とか北神竜とか
Dialogue: 0,0:19:30.27,0:19:32.77,对白 日语,,0,0,0,,そういう竜派の定石みたいなものは
Dialogue: 0,0:19:32.77,0:19:34.25,对白 日语,,0,0,0,,全て網羅している
Dialogue: 0,0:19:34.25,0:19:36.70,对白 日语,,0,0,0,,当然使っても対処されるし
Dialogue: 0,0:19:36.70,0:19:38.37,对白 日语,,0,0,0,,向こうも使ってくる
Dialogue: 0,0:19:38.37,0:19:41.29,对白 日语,,0,0,0,,ならこっちも覚えとかなきゃ
Dialogue: 0,0:19:41.29,0:19:43.59,对白 日语,,0,0,0,,互角には戦えねえ
Dialogue: 0,0:19:43.59,0:19:44.16,对白 日语,,0,0,0,,なるほど
Dialogue: 0,0:19:44.16,0:19:47.96,对白 日语,,0,0,0,,ではいずれ水神竜も呼ぶのか
Dialogue: 0,0:19:47.96,0:19:50.22,对白 日语,,0,0,0,,ああ手紙は送ってある
Dialogue: 0,0:19:50.22,0:19:51.92,对白 日语,,0,0,0,,そうか
Dialogue: 0,0:19:51.92,0:19:55.74,对白 日语,,0,0,0,,では北帝オルステッドの
Dialogue: 0,0:19:55.75,0:19:57.75,对白 日语,,0,0,0,,お世話になります
Dialogue: 0,0:19:57.75,0:19:59.75,对白 日语,,0,0,0,,先日の苛烈な歓迎
Dialogue: 0,0:19:59.75,0:20:01.75,对白 日语,,0,0,0,,大変心躍るものであった
Dialogue: 0,0:20:01.75,0:20:03.75,对白 日语,,0,0,0,,狂犬の腕前
Dialogue: 0,0:20:03.75,0:20:05.75,对白 日语,,0,0,0,,改めて確かめさせていただく
Dialogue: 0,0:20:07.75,0:20:09.75,对白 日语,,0,0,0,,始め
Dialogue: 0,0:20:19.75,0:20:21.75,对白 日语,,0,0,0,,お前は何をしているのか
Dialogue: 0,0:20:21.75,0:20:23.75,对白 日语,,0,0,0,,お前は何をしているのか
Dialogue: 0,0:20:23.75,0:20:24.75,对白 日语,,0,0,0,,冗談だよ
Dialogue: 0,0:20:46.72,0:20:47.75,对白 日语,,0,0,0,,を
Dialogue: 0,0:20:47.75,0:20:48.55,对白 日语,,0,0,0,,本
Dialogue: 0,0:20:48.55,0:20:49.46,对白 日语,,0,0,0,,修器
Dialogue: 0,0:20:49.46,0:20:50.46,对白 日语,,0,0,0,,くず
Dialogue: 0,0:20:50.46,0:20:51.46,对白 日语,,0,0,0,,うううデ四重
Dialogue: 0,0:20:51.46,0:20:52.57,对白 日语,,0,0,0,,うううで
Dialogue: 0,0:20:52.57,0:20:53.57,对白 日语,,0,0,0,,ううう
Dialogue: 0,0:20:53.57,0:20:53.66,对白 日语,,0,0,0,,ということだった
Dialogue: 0,0:20:53.66,0:20:53.74,对白 日语,,0,0,0,,Judy
Dialogue: 0,0:20:53.74,0:20:58.12,对白 日语,,0,0,0,,剣士が私 魔術師がルーデウス
Dialogue: 0,0:21:01.24,0:21:02.96,对白 日语,,0,0,0,,ルーデウスは…
Dialogue: 0,0:21:06.79,0:21:09.00,对白 日语,,0,0,0,,すごいんだから!
Dialogue: 0,0:21:23.74,0:21:25.57,对白 日语,,0,0,0,,ドン! ドン!
Dialogue: 0,0:21:26.57,0:21:27.62,对白 日语,,0,0,0,,あっ…
Dialogue: 0,0:21:27.81,0:21:28.81,对白 日语,,0,0,0,,はっ…
Dialogue: 0,0:21:29.50,0:21:32.88,对白 日语,,0,0,0,,おおっ あれはまさしく光の太刀!
Dialogue: 0,0:21:33.03,0:21:35.83,对白 日语,,0,0,0,,速さ 威力ともに申し分ない
Dialogue: 0,0:21:36.62,0:21:37.83,对白 日语,,0,0,0,,すごい…
Dialogue: 0,0:21:39.79,0:21:40.79,对白 日语,,0,0,0,,へっ
Dialogue: 0,0:21:41.00,0:21:42.00,对白 日语,,0,0,0,,はっ…
Dialogue: 0,0:21:43.38,0:21:44.38,对白 日语,,0,0,0,,うっ…
Dialogue: 0,0:21:45.22,0:21:49.01,对白 日语,,0,0,0,,いやはや 誠に鮮やかな一撃であった
Dialogue: 0,0:21:49.94,0:21:53.51,对白 日语,,0,0,0,,もう一試合 よろしいですかな?
Dialogue: 0,0:21:53.74,0:21:54.74,对白 日语,,0,0,0,,はっ…
Dialogue: 0,0:21:55.85,0:21:57.03,对白 日语,,0,0,0,,当然よ!
Dialogue: 0,0:21:57.57,0:21:58.57,对白 日语,,0,0,0,,だーっ!
Dialogue: 0,0:22:23.74,0:22:28.53,对白 日语,,0,0,0,,まさしく 雷のような 泡のような愛に
Dialogue: 0,0:22:29.62,0:22:37.57,对白 日语,,0,0,0,,くるまれていたまま 忘れてしまいそうなさに
Dialogue: 0,0:22:38.07,0:22:45.75,对白 日语,,0,0,0,,いつまでも 燃え続けられるような 日々を捧ぐ
Dialogue: 0,0:22:46.51,0:22:53.51,对白 日语,,0,0,0,,言葉でも 心でも 流れる赤い血も
Dialogue: 0,0:22:53.51,0:22:54.51,对白 日语,,0,0,0,,全部
Dialogue: 0,0:22:55.13,0:23:03.81,对白 日语,,0,0,0,,神様なんかじゃ 触れないとこまで 愛しくて
Dialogue: 0,0:23:04.20,0:23:13.20,对白 日语,,0,0,0,,絡める指の 先の先まで ほら 楽を売ってる
Dialogue: 0,0:23:13.20,0:23:21.42,对白 日语,,0,0,0,,あなたの涙が 笑顔の頬を伝えますように
Dialogue: 0,0:23:21.42,0:23:23.42,对白 日语,,0,0,0,,祈り終われば…
Dialogue: 0,0:23:24.09,0:23:27.44,对白 日语,,0,0,0,,眠りにつくから
Dialogue: 0,0:23:35.57,0:23:39.59,对白 日语,,0,0,0,,Li-A-Li-A-Li
